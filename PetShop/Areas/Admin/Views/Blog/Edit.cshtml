@model PetShop.Areas.Admin.Models.BlogPostFormViewModel
@{
    ViewData["Title"] = "Məqaləni Redaktə Et | Admin";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        
        <!-- Səhifə Başlığı -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Məzmun İdarəetməsi</p>
                    <h1 class="h3 mb-1">Məqaləni Redaktə Et</h1>
                    <p class="text-muted mb-0">Mövcud məqalənin məlumatlarını və şəklini yeniləyin.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Siyahıya Qayıt</span>
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <div class="panel">
                    <div class="panel-header">
                        <h2 class="h5 mb-0 section-title">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>Məqalə Parametrləri</span>
                        </h2>
                    </div>
                    <div class="p-4">
                        <form method="post" asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ExistingImageUrl" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label asp-for="Title" class="form-label fw-semibold">Məqalə Başlığı <span class="text-danger">*</span></label>
                                    <input asp-for="Title" id="articleTitle" class="form-control" />
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="AuthorName" class="form-label fw-semibold">Müəllif <span class="text-danger">*</span></label>
                                    <input asp-for="AuthorName" class="form-control" />
                                    <span asp-validation-for="AuthorName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Slug" class="form-label fw-semibold">Slug (URL)</label>
                                <input asp-for="Slug" id="articleSlug" class="form-control" />
                                <div class="text-muted small mt-1">URL üçün oxunaqlı ad. Dəyişdirilməsi məqalənin köhnə keçidlərini yeniləyəcək.</div>
                                <span asp-validation-for="Slug" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Summary" class="form-label fw-semibold">Qısa Xülasə <span class="text-danger">*</span></label>
                                <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Summary" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Content" class="form-label fw-semibold">Tam Mətn (Məzmun) <span class="text-danger">*</span></label>
                                <textarea asp-for="Content" class="form-control font-monospace" rows="12"></textarea>
                                <span asp-validation-for="Content" class="text-danger small"></span>
                            </div>

                            <!-- Şəkil Bölməsi -->
                            <div class="card p-3 mb-4 bg-light border-0 rounded-3">
                                <label class="form-label fw-semibold mb-2">
                                    <i class="bi bi-image me-1"></i>Məqalə Şəkli
                                </label>

                                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                                {
                                    <div class="mb-3" id="currentImageWrapper">
                                        <p class="small text-muted mb-1">Hazırkı şəkil:</p>
                                        <img src="@Model.ExistingImageUrl" alt="Mövcud şəkil" class="img-thumbnail rounded-3 shadow-sm" style="max-height: 180px;" />
                                    </div>
                                }

                                <label asp-for="ImageFile" class="form-label small text-muted">Şəkli dəyişmək üçün yenisini seçin (Seçilməzsə hazırkı şəkil qalacaq):</label>
                                <input asp-for="ImageFile" type="file" class="form-control mb-2" accept="image/*" id="imageInput" />
                                <div class="text-muted small">Dəstəklənən formatlar: JPG, PNG, WEBP.</div>

                                <div class="mt-3 d-none" id="previewWrapper">
                                    <p class="small text-success mb-1 fw-semibold">Yeni seçilmiş şəkil önbaxışı:</p>
                                    <img id="imagePreview" src="#" alt="Yeni şəkil" class="img-thumbnail rounded-3 shadow-sm border-success" style="max-height: 200px;" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">Ləğv et</a>
                                <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check-lg"></i>
                                    <span>Yenilə</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Şəkil önbaxışı
        const imageInput = document.getElementById('imageInput');
        const previewWrapper = document.getElementById('previewWrapper');
        const imagePreview = document.getElementById('imagePreview');

        imageInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    previewWrapper.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            } else {
                previewWrapper.classList.add('d-none');
            }
        });
    </script>
}
