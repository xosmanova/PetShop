@model PetShop.Areas.Admin.Models.UserListAdminViewModel
@{
    ViewData["Title"] = "User List | Admin";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Səhifə Başlığı -->
        <div class="page-heading d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                <div>
                    <h1 class="h3 mb-1">User List</h1>
                    <p class="text-muted mb-0">Search, review, and manage team member accounts.</p>
                </div>
            </div>
            <div class="heading-actions d-flex align-items-center gap-2">
                <a asp-action="AddUser" class="btn btn-primary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-person-plus"></i>
                    <span>Add User</span>
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- İstifadəçilər Cədvəli Paneli -->
        <section class="panel">
            <div class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <h2 class="h5 mb-0 section-title d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill text-primary"></i>
                    <span>Users</span>
                </h2>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm" style="min-width: 220px; max-width: 300px;">
                            <span class="input-group-text bg-transparent border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="search" value="@Model.Search" 
                                   class="form-control border-start-0" 
                                   placeholder="Search users..." />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear search">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </form>
                    <a asp-action="AddUser" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                        <i class="bi bi-person-plus"></i>
                        <span>Add User</span>
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>USER</th>
                            <th>ROLE</th>
                            <th>TEAM</th>
                            <th>STATUS</th>
                            <th>JOINED</th>
                            <th class="text-end" style="width: 100px;">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users != null && Model.Users.Count > 0)
                        {
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="user-avatar-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                                 style="width: 38px; height: 38px; border-radius: 50%; font-size: 0.85rem; background: linear-gradient(135deg, #2563eb, #10b981); flex-shrink: 0; letter-spacing: 0.5px;">
                                                @user.Initials
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark">@user.FullName</div>
                                                <div class="small text-muted">@user.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark">@user.Role</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">@user.Team</span>
                                    </td>
                                    <td>
                                        @switch (user.Status?.ToLower())
                                        {
                                            case "active":
                                                <span class="badge text-bg-success px-2 py-1 rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Active
                                                </span>
                                                break;
                                            case "pending":
                                                <span class="badge text-bg-warning px-2 py-1 rounded-pill">
                                                    <i class="bi bi-hourglass-split me-1"></i>Pending
                                                </span>
                                                break;
                                            case "suspended":
                                                <span class="badge text-bg-danger px-2 py-1 rounded-pill">
                                                    <i class="bi bi-slash-circle me-1"></i>Suspended
                                                </span>
                                                break;
                                            default:
                                                <span class="badge text-bg-secondary px-2 py-1 rounded-pill">@user.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @user.JoinedDate.ToString("dd.MM.yyyy")
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" title="View details">
                                            <i class="bi bi-eye"></i>
                                            <span>View</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-people fs-1 d-block mb-2"></i>
                                        <p class="mb-1">No users found.</p>
                                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                                        {
                                            <a asp-action="Index" class="btn btn-sm btn-outline-primary mt-2">Clear search filter</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Cədvəl Altı: Showing X to Y of Z və Pagination -->
            <div class="p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    Showing @Model.StartIndex to @Model.EndIndex of @Model.TotalCount users
                </span>
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Users pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <!-- Previous düyməsi -->
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.CurrentPage - 1)" 
                                   asp-route-search="@Model.Search">
                                    Previous
                                </a>
                            </li>

                            <!-- Səhifə nömrələri (1, 2, ...) -->
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@p" 
                                       asp-route-search="@Model.Search">
                                        @p
                                    </a>
                                </li>
                            }

                            <!-- Next düyməsi -->
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.CurrentPage + 1)" 
                                   asp-route-search="@Model.Search">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </section>

    </div>
</main>
