@{
    ViewData["Title"] = "Modals | adminHMD";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Page Heading -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-window-stack" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">OVERLAY</p>
                    <h1 class="h3 mb-1">Modals</h1>
                    <p class="text-muted mb-0">Modal dialogs for confirmations and compact workflows.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard-a Qayıt</span>
                </a>
            </div>
        </div>

        <div class="row g-4">
            <!-- Sol Kart: Modal Examples -->
            <div class="col-12 col-lg-7">
                <div class="panel h-100">
                    <div class="panel-header">
                        <h2 class="h5 mb-1 section-title">
                            <i class="bi bi-collection-play me-2 text-primary"></i>
                            <span>Modal Examples</span>
                        </h2>
                        <p class="text-muted mb-0">Interactive modal dialogs built with Bootstrap 5 components.</p>
                    </div>
                    <div class="p-4">
                        <p class="text-secondary mb-4">
                            Click the buttons below to trigger live modal demonstrations. These dialogs handle both standard user confirmations and compact workflow data entries.
                        </p>
                        <div class="d-flex flex-wrap gap-3">
                            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2" data-bs-toggle="modal" data-bs-target="#confirmModal">
                                <i class="bi bi-check-circle"></i>
                                <span>Open Confirm Modal</span>
                            </button>
                            <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3 py-2" data-bs-toggle="modal" data-bs-target="#formModal">
                                <i class="bi bi-input-cursor-text"></i>
                                <span>Open Form Modal</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sağ Kart: Usage -->
            <div class="col-12 col-lg-5">
                <div class="panel h-100">
                    <div class="panel-header">
                        <h2 class="h5 mb-1 section-title">
                            <i class="bi bi-info-circle me-2 text-info"></i>
                            <span>Usage</span>
                        </h2>
                        <p class="text-muted mb-0">Best practices and design principles.</p>
                    </div>
                    <div class="p-4">
                        <p class="text-secondary mb-3">
                            Use modals for focused confirmations, compact forms, and high-priority decisions without leaving the page.
                        </p>
                        <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-shield-check text-primary fs-5 mt-n1"></i>
                                <div>
                                    <strong class="text-dark d-block">Critical Decisions</strong>
                                    <small class="text-muted">Ensure users deliberately confirm high-impact actions like deletion or state cancellation.</small>
                                </div>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-lightning-charge text-warning fs-5 mt-n1"></i>
                                <div>
                                    <strong class="text-dark d-block">Compact Workflows</strong>
                                    <small class="text-muted">Keep forms short and actionable so users remain within their current context without page reloads.</small>
                                </div>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-moon-stars text-info fs-5 mt-n1"></i>
                                <div>
                                    <strong class="text-dark d-block">Theme Adaptive</strong>
                                    <small class="text-muted">Both light and dark modes automatically render appropriate contrast, borders, and backdrop overlays.</small>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

<!-- Confirm Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary p-2" style="width: 38px; height: 38px;">
                        <i class="bi bi-question-circle fs-5"></i>
                    </span>
                    <h5 class="modal-title fw-bold" id="confirmModalLabel">Confirm Action</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0 text-secondary">
                    Are you sure you want to proceed with this action? This operation will apply the selected changes to the system and cannot be reversed.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Form Modal -->
<div class="modal fade" id="formModal" tabindex="-1" aria-labelledby="formModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary p-2" style="width: 38px; height: 38px;">
                        <i class="bi bi-pencil-square fs-5"></i>
                    </span>
                    <h5 class="modal-title fw-bold" id="formModalLabel">Quick Entry Form</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="demoWorkflowForm" onsubmit="event.preventDefault(); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide();">
                    <div class="mb-3">
                        <label for="modalItemTitle" class="form-label fw-semibold">Item Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="modalItemTitle" placeholder="Enter title or label" required>
                    </div>
                    <div class="mb-3">
                        <label for="modalItemCategory" class="form-label fw-semibold">Category</label>
                        <select class="form-select" id="modalItemCategory">
                            <option selected value="General">General</option>
                            <option value="Inventory">Inventory</option>
                            <option value="Customer">Customer</option>
                            <option value="System">System</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="modalItemNotes" class="form-label fw-semibold">Notes / Description</label>
                        <textarea class="form-control" id="modalItemNotes" rows="3" placeholder="Brief workflow description..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="document.getElementById('demoWorkflowForm').requestSubmit()">Submit</button>
            </div>
        </div>
    </div>
</div>
