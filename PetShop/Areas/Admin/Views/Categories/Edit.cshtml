@model PetShop.Areas.Admin.Models.CategoryFormViewModel
@{
    ViewData["Title"] = $"{Model.Name} - Redaktə Et | Admin";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        
        <!-- Səhifə Başlığı -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Kataloq İdarəetməsi</p>
                    <h1 class="h3 mb-1">Kateqoriyanı Redaktə Et</h1>
                    <p class="text-muted mb-0"><code>@Model.Name</code> kateqoriyasının parametrlərini dəyişin.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Siyahıya Qayıt</span>
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="panel">
                    <div class="panel-header">
                        <h2 class="h5 mb-0 section-title">
                            <i class="bi bi-card-checklist"></i>
                            <span>Kateqoriya Parametrləri</span>
                        </h2>
                    </div>
                    <div class="p-4">
                        <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">Kateqoriya Adı <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Slug" class="form-label fw-semibold">Slug (URL Dostu Ad)</label>
                                <input asp-for="Slug" class="form-control" />
                                <div class="text-muted small mt-1">İstəyə bağlıdır. Boş buraxsanız, kateqoriya adına uyğun slug avtomatik generasiya ediləcək.</div>
                                <span asp-validation-for="Slug" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ParentCategoryId" class="form-label fw-semibold">Ana Kateqoriya</label>
                                <select asp-for="ParentCategoryId" asp-items="ViewBag.ParentCategories" class="form-select">
                                    <option value="">-- Əsas Kateqoriya (Valideyn yoxdur) --</option>
                                </select>
                                <div class="text-muted small mt-1">Bu kateqoriyanın tabe olduğu ana kateqoriya.</div>
                                <span asp-validation-for="ParentCategoryId" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="IconClass" class="form-label fw-semibold">İkon Sinfi</label>
                                <input asp-for="IconClass" class="form-control" />
                                <div class="text-muted small mt-1">Menyuda və kateqoriya kartlarında göstəriləcək ikon sinfi (Məs: <code>ph:bowl-food</code>, <code>bi bi-tag</code>).</div>
                                <span asp-validation-for="IconClass" class="text-danger small"></span>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>Dəyişiklikləri Yadda Saxla</span>
                                </button>
                                <a asp-action="Index" class="btn btn-light text-muted">Ləğv Et</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
