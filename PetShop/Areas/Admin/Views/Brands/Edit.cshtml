@model PetShop.Areas.Admin.Models.BrandFormViewModel
@{
    ViewData["Title"] = $"{Model.Name} - Redaktə Et | Admin";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        
        <!-- Səhifə Başlığı -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Kataloq İdarəetməsi</p>
                    <h1 class="h3 mb-1">Brendi Redaktə Et</h1>
                    <p class="text-muted mb-0"><code>@Model.Name</code> brendinin məlumatlarını və loqosunu yeniləyin.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Siyahıya Qayıt</span>
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-lg-7">
                <div class="panel">
                    <div class="panel-header">
                        <h2 class="h5 mb-0 section-title">
                            <i class="bi bi-card-checklist"></i>
                            <span>Brend Məlumatları</span>
                        </h2>
                    </div>
                    <div class="p-4">
                        <form method="post" asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ExistingLogoUrl" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">Brend Adı <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- Mövcud Loqo -->
                            <div class="mb-3">
                                <p class="form-label fw-semibold mb-1">Mövcud Loqo</p>
                                @if (!string.IsNullOrEmpty(Model.ExistingLogoUrl))
                                {
                                    <div class="d-inline-block p-2 bg-light rounded border text-center">
                                        <img src="@Model.ExistingLogoUrl" alt="@Model.Name" 
                                             class="img-thumbnail shadow-sm bg-white" 
                                             style="max-height: 80px; max-width: 160px; object-fit: contain;" loading="lazy" />
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">Loqo yüklənməyib.</p>
                                }
                            </div>

                            <div class="mb-4">
                                <label asp-for="LogoFile" class="form-label fw-semibold">Loqonu Dəyişdir</label>
                                <input asp-for="LogoFile" type="file" class="form-control" id="logoInput" accept="image/*" />
                                <div class="text-muted small mt-1">Yeni şəkil seçsəniz, mövcud loqo əvəzlənəcək və <code>wwwroot/images/brands/</code> qovluğuna yazılacaq.</div>
                                <span asp-validation-for="LogoFile" class="text-danger small"></span>

                                <!-- Yeni Loqo Önbaxışı -->
                                <div id="logoPreviewContainer" class="d-none mt-3 text-center">
                                    <p class="small text-success fw-semibold mb-1">Yeni Seçilmiş Loqo:</p>
                                    <img id="logoPreview" src="#" alt="Yeni loqo önbaxış" 
                                         class="img-thumbnail shadow-sm rounded border-success p-2 bg-white" 
                                         style="max-height: 100px; max-width: 180px; object-fit: contain;" />
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>Dəyişiklikləri Yadda Saxla</span>
                                </button>
                                <a asp-action="Index" class="btn btn-light text-muted">Ləğv Et</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var logoInput = document.getElementById('logoInput');
            var previewContainer = document.getElementById('logoPreviewContainer');
            var previewImage = document.getElementById('logoPreview');

            if (logoInput) {
                logoInput.addEventListener('change', function () {
                    var file = this.files[0];
                    if (file) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            previewImage.src = e.target.result;
                            previewContainer.classList.remove('d-none');
                        };
                        reader.readAsDataURL(file);
                    } else {
                        previewImage.src = '#';
                        previewContainer.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}
