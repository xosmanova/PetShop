@model PetShop.DataContext.Entites.Coupon
@{
    ViewData["Title"] = "Yeni Kupon Əlavə Et | Admin";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        
        <!-- Səhifə Başlığı -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-ticket-perforated" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Marketinq & Kampaniyalar</p>
                    <h1 class="h3 mb-1">Yeni Kupon Əlavə Et</h1>
                    <p class="text-muted mb-0">Müştərilər üçün xüsusi endirim kodu və şərtlər təyin edin.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Siyahıya Qayıt</span>
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="panel">
                    <div class="panel-header">
                        <h2 class="h5 mb-0 section-title">
                            <i class="bi bi-card-checklist"></i>
                            <span>Kupon Parametrləri</span>
                        </h2>
                    </div>
                    <div class="p-4">
                        <form method="post" asp-action="Create">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Code" class="form-label fw-semibold">Kupon Kodu <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-ticket"></i></span>
                                    <input asp-for="Code" class="form-control text-uppercase font-monospace" placeholder="Məs: YAY2026, PET10, ENDIRIM50" style="letter-spacing: 1px;" />
                                </div>
                                <div class="text-muted small mt-1">Həriflər avtomatik böyük hərflərə çevriləcək. Yalnız unikal kodlar qəbul edilir.</div>
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="DiscountType" class="form-label fw-semibold">Endirim Növü <span class="text-danger">*</span></label>
                                    <select asp-for="DiscountType" class="form-select" id="discountTypeSelect">
                                        <option value="1">Faizlə Endirim (%)</option>
                                        <option value="2">Sabit Məbləğ Endirimi (₼)</option>
                                    </select>
                                    <span asp-validation-for="DiscountType" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="DiscountValue" class="form-label fw-semibold">Endirim Dəyəri <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input asp-for="DiscountValue" type="number" step="0.01" min="0.01" class="form-control" placeholder="Məs: 10 və ya 25.00" />
                                        <span class="input-group-text" id="discountValueUnit">%</span>
                                    </div>
                                    <div class="text-muted small mt-1" id="discountValueHint">Faiz seçildikdə məs: 10 daxil edilsə, səbətdən 10% çıxılacaq.</div>
                                    <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="MinOrderAmount" class="form-label fw-semibold">Minimum Sifariş Məbləği</label>
                                    <div class="input-group">
                                        <input asp-for="MinOrderAmount" type="number" step="0.01" min="0" class="form-control" placeholder="Məs: 30.00" />
                                        <span class="input-group-text">₼</span>
                                    </div>
                                    <div class="text-muted small mt-1">İstəyə bağlıdır. Boş buraxsanız, istənilən məbləğdə tətbiq edilə bilər.</div>
                                    <span asp-validation-for="MinOrderAmount" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="ExpiryDate" class="form-label fw-semibold">Bitmə Tarixi</label>
                                    <input asp-for="ExpiryDate" type="date" class="form-control" 
                                           value="@(Model?.ExpiryDate?.ToString("yyyy-MM-dd"))" />
                                    <div class="text-muted small mt-1">İstəyə bağlıdır. Boş buraxsanız, kupon daimi qüvvədə qalacaq.</div>
                                    <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-4 pt-2">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                                    <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                        Kupon dərhal aktiv olsun
                                    </label>
                                </div>
                                <div class="text-muted small">Deaktiv kuponları müştərilər səbətdə istifadə edə bilməyəcək.</div>
                                <span asp-validation-for="IsActive" class="text-danger small"></span>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check-lg"></i>
                                    <span>Kuponu Yadda Saxla</span>
                                </button>
                                <a asp-action="Index" class="btn btn-light text-muted">Ləğv Et</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var typeSelect = document.getElementById('discountTypeSelect');
            var unitSpan = document.getElementById('discountValueUnit');
            var hintDiv = document.getElementById('discountValueHint');

            function updateUnit() {
                if (!typeSelect || !unitSpan) return;
                if (typeSelect.value === '1') {
                    unitSpan.textContent = '%';
                    if (hintDiv) hintDiv.textContent = 'Faiz seçildikdə məs: 10 daxil edilsə, səbətdən 10% çıxılacaq.';
                } else {
                    unitSpan.textContent = '₼';
                    if (hintDiv) hintDiv.textContent = 'Sabit məbləğ seçildikdə məs: 15 daxil edilsə, ümumi məbləğdən 15 ₼ çıxılacaq.';
                }
            }

            if (typeSelect) {
                typeSelect.addEventListener('change', updateUnit);
                updateUnit();
            }
        });
    </script>
}
