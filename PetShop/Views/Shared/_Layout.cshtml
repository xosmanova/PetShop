    <form id="__antiforgeryTokenForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    <script>
        $(function () {
            var token = $('input[name="__RequestVerificationToken"]').first().val();
            if (token) {
                $.ajaxSetup({
                    headers: {
                        'RequestVerificationToken': token
                    }
                });
            }
        });

        function updateWishlistBadge(count) {
            $('.wishlist-count').each(function () {
                $(this).text(count);
                if (count > 0) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        $(document).on('click', '.btn-wishlist', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var productId = $btn.data('product-id');
            if (!productId) return;

            $.ajax({
                url: '/Wishlist/Toggle',
                type: 'POST',
                data: { productId: productId },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (res) {
                    if (res && res.success) {
                        updateWishlistBadge(res.count);
                        var $icon = $btn.find('iconify-icon');
                        if (res.inWishlist) {
                            $btn.addClass('active-wishlist');
                            $icon.css('color', '#dc3545');
                        } else {
                            $btn.removeClass('active-wishlist');
                            $icon.css('color', '');
                        }
                    }
                },
                error: function (xhr) {
                    console.error('Wishlist error:', xhr);
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
        