@using System.Security.Claims
@using PetShop.DataContext.Entites
@using Microsoft.AspNetCore.Identity
@inject PetShop.DataContext.AppDbContext _context
@inject UserManager<ApplicationUser> _userManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var sessionId = Context.Session.GetString("BasketSessionId");
    var userId = User.Identity?.IsAuthenticated == true ? User.FindFirstValue(ClaimTypes.NameIdentifier) : null;
    ApplicationUser? currentUser = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await _userManager.GetUserAsync(User);
    }

    var wishlistCount = _context.Wishlist.Count(w => (!string.IsNullOrEmpty(userId) && w.UserId == userId) || (!string.IsNullOrEmpty(sessionId) && w.SessionId == sessionId && w.UserId == null));
    var basketCount = _context.BasketItems
        .Where(bi => (!string.IsNullOrEmpty(userId) && bi.Basket.UserId == userId) || (!string.IsNullOrEmpty(sessionId) && bi.Basket.SessionId == sessionId && bi.Basket.UserId == null))
        .Sum(bi => (int?)bi.Quantity) ?? 0;

    var companyPhone = Configuration["CompanyInfo:Phone"] ?? "+994 50 123 45 67";
    var companyEmail = Configuration["CompanyInfo:Email"] ?? "info@petshop.az";
    var companyAddress = Configuration["CompanyInfo:Address"] ?? "Bakı, Azərbaycan";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isHomeActive = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && 
                       (string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(currentAction));
    var isShopActive = string.Equals(currentController, "Shop", StringComparison.OrdinalIgnoreCase) || 
                       string.Equals(currentController, "Product", StringComparison.OrdinalIgnoreCase);
    var isBasketActive = string.Equals(currentController, "Basket", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(currentController, "Checkout", StringComparison.OrdinalIgnoreCase);
    var isContactActive = string.Equals(currentController, "Contact", StringComparison.OrdinalIgnoreCase);
    var isBlogActive = string.Equals(currentController, "Blog", StringComparison.OrdinalIgnoreCase);
    var isAboutActive = string.Equals(currentController, "AboutUs", StringComparison.OrdinalIgnoreCase);
    var isOffersActive = string.Equals(currentController, "Offers", StringComparison.OrdinalIgnoreCase);
    var isFaqsActive = string.Equals(currentController, "Faqs", StringComparison.OrdinalIgnoreCase);
    var isPaymentActive = string.Equals(currentController, "Payment", StringComparison.OrdinalIgnoreCase);
    var isReturnsActive = string.Equals(currentController, "Returns", StringComparison.OrdinalIgnoreCase);
    var isDeliveryActive = string.Equals(currentController, "Delivery", StringComparison.OrdinalIgnoreCase);
}
