@model PetShop.DataContext.Entites.Basket

<div class="offcanvas-header justify-content-between border-bottom pb-3">
    <h5 class="offcanvas-title mb-0">Səbətiniz</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
</div>
<div class="offcanvas-body">
    <div class="order-md-last">
        <h4 class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-primary">Your cart</span>
            <span class="badge bg-primary rounded-circle pt-2 cart-count">@Model.BasketItems.Sum(i => i.Quantity)</span>
        </h4>

        @if (!Model.BasketItems.Any())
        {
            <div class="text-center py-4">
                <p class="text-secondary mb-3">Səbətiniz boşdur.</p>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary btn-sm">Alış-verişə başla</a>
            </div>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var item in Model.BasketItems)
                {
                    var mainImg = item.Product.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png";
                    var variantLabel = item.ProductVariant != null
                        ? string.Join(" / ", new[] { item.ProductVariant.Size, item.ProductVariant.Weight, item.ProductVariant.Color }.Where(x => !string.IsNullOrEmpty(x)))
                        : null;

                    <li class="list-group-item d-flex justify-content-between align-items-center lh-sm py-3">
                        <div class="d-flex align-items-center gap-2">
                            <img src="@mainImg" alt="@item.Product.Name" class="rounded" style="width: 48px; height: 48px; object-fit: cover;" loading="lazy" />
                            <div>
                                <h6 class="my-0 text-dark">@item.Product.Name</h6>
                                @if (!string.IsNullOrEmpty(variantLabel))
                                {
                                    <small class="text-secondary d-block">@variantLabel</small>
                                }
                                @{
                                    var isItemDiscounted = item.Product.DiscountPrice.HasValue && item.Product.DiscountPrice.Value < item.Product.Price;
                                    var origPrice = item.Product.Price + (item.ProductVariant?.PriceModifier ?? 0m);
                                }
                                <small class="text-secondary">
                                    Miqdar: <strong class="text-dark">@item.Quantity</strong> × 
                                    @if (isItemDiscounted)
                                    {
                                        <del class="text-muted me-1">@origPrice.ToString("0.00") ₼</del>
                                        <span class="text-danger fw-semibold">@item.UnitPrice.ToString("0.00") ₼</span>
                                    }
                                    else
                                    {
                                        <span>@item.UnitPrice.ToString("0.00") ₼</span>
                                    }
                                </small>
                            </div>
                        </div>
                        <span class="text-dark fw-bold">@(item.UnitPrice * item.Quantity) ₼</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between py-3 bg-light">
                    <span class="fw-bold text-dark">Ümumi Məbləğ</span>
                    <strong class="text-primary fs-5">@Model.BasketItems.Sum(i => i.UnitPrice * i.Quantity) ₼</strong>
                </li>
            </ul>

            <div class="d-flex flex-column gap-2">
                <a asp-controller="Basket" asp-action="Index" class="w-100 btn btn-outline-dark">
                    Səbətə bax
                </a>
                <a asp-controller="Checkout" asp-action="Index" class="w-100 btn btn-primary">
                    Continue to checkout
                </a>
            </div>
        }
    </div>
</div>
