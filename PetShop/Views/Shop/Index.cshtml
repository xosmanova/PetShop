@model PetShop.Models.ShopViewModel

<section id="banner" class="py-3" style="background: #E8F5EE;">
    <div class="container">
        <div class="hero-content py-5 my-3">
            <h2 class="display-1 mt-3 mb-0">Shop</h2>
            <nav class="breadcrumb">
                <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active" aria-current="page">Shop</span>
            </nav>
        </div>
    </div>
</section>

<div class="shopify-grid">
    <div class="container py-5 my-5">
        <div class="row g-md-5 mb-5">

            <main class="col-md-9">
                <div class="filter-shop d-md-flex justify-content-between align-items-center">
                    <div class="showing-product">
                        @{
                            var from = Model.TotalCount == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                            var to = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
                        }
                        <p class="m-0">Showing @from–@to of @Model.TotalCount results</p>
                    </div>
                    <div class="sort-by">
                        <form method="get" asp-controller="Shop" asp-action="Index" id="sortForm">
                            <input type="hidden" name="category" value="@Model.SelectedCategory" />
                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                            <input type="hidden" name="brand" value="@Model.SelectedBrand" />
                            <input type="hidden" name="brandId" value="@Model.SelectedBrandId" />
                            <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                            <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                            <select name="sort" class="filter-categories border-0 m-0" onchange="this.form.submit()">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Default sorting</option>
                                <option value="name_asc" selected="@(Model.Sort == "name_asc")">Name (A - Z)</option>
                                <option value="name_desc" selected="@(Model.Sort == "name_desc")">Name (Z - A)</option>
                                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Price (Low-High)</option>
                                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Price (High-Low)</option>
                            </select>
                        </form>
                    </div>
                </div>

                <div class="product-grid row">
                    @if (!Model.Products.Any())
                    {
                        <div class="text-center py-5">
                            <h4>Bu filtrə uyğun məhsul tapılmadı.</h4>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark mt-3">Bütün məhsulları göstər</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            var mainImage = product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                            ?? product.Images.FirstOrDefault()?.ImageUrl
                            ?? "/images/no-image.png";
                            var displayPrice = product.DiscountPrice ?? product.Price;
                            var isWishlisted = Model.WishlistProductIds.Contains(product.Id);

                            <div class="col-md-4 my-4 d-flex align-items-stretch">
                                <div class="card position-relative h-100 w-100 product-card">
                                    <div>
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="product-image-container" style="height: 260px; width: 100%; overflow: hidden; display: block; border-radius: 1rem; background-color: #f8f9fa;">
                                            <img src="@mainImage" class="img-fluid rounded-4 product-img" alt="@product.Name" loading="lazy" style="height: 100%; width: 100%; object-fit: cover; object-position: center; display: block;">
                                        </a>
                                        <div class="card-body p-0 pt-3">
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark">
                                                <h3 class="card-title m-0 text-dark product-title">@product.Name</h3>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="card-text mt-auto pt-3">
                                        <h3 class="secondary-font text-primary">@displayPrice ₼</h3>

                                        <div class="d-flex flex-wrap mt-3">
                                            <form asp-controller="Basket" asp-action="AddToCart" method="post" class="me-3">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <button type="submit" class="btn-cart px-4 pt-3 pb-3 border-0 bg-transparent">
                                                    <h5 class="text-uppercase m-0">Add to Cart</h5>
                                                </button>
                                            </form>
                                            <a href="#" class="btn-wishlist px-4 pt-3 @(isWishlisted ? "active-wishlist" : "")" data-product-id="@product.Id" title="İstək siyahısına əlavə et">
                                                <iconify-icon icon="fluent:heart-28-filled" class="fs-5" style="@(isWishlisted ? "color: #dc3545;" : "")"></iconify-icon>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <!-- / product-grid -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="navigation paging-navigation text-center mt-5" role="navigation">
                        <div class="pagination loop-pagination d-flex justify-content-center align-items-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sort="@Model.Sort"
                                   class="pagination-arrow d-flex align-items-center mx-3">
                                    <iconify-icon icon="ic:baseline-keyboard-arrow-left" class="pagination-arrow fs-1"></iconify-icon>
                                </a>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <span aria-current="page" class="page-numbers mt-2 fs-3 mx-3 current">@i</span>
                                }
                                else
                                {
                                    <a class="page-numbers mt-2 fs-3 mx-3"
                                       asp-controller="Shop" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-category="@Model.SelectedCategory"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-brand="@Model.SelectedBrand"
                                       asp-route-brandId="@Model.SelectedBrandId"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-sort="@Model.Sort">@i</a>
                                }
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sort="@Model.Sort"
                                   class="pagination-arrow d-flex align-items-center mx-3">
                                    <iconify-icon icon="ic:baseline-keyboard-arrow-right" class="pagination-arrow fs-1"></iconify-icon>
                                </a>
                            }
                        </div>
                    </nav>
                }

            </main>

            <aside class="col-md-3 mt-5">
                <div class="sidebar">
                    <div class="widget-menu">
                        <div class="widget-search-bar">
                            <div class="search-bar border rounded-2 border-dark-subtle pe-3">
                                <form id="search-form" class="text-center d-flex align-items-center" asp-controller="Shop" asp-action="Search" method="get">
                                    <input type="text" name="query" class="form-control border-0 bg-transparent" placeholder="Search for products" />
                                    <button type="submit" class="border-0 bg-transparent p-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                            <path fill="currentColor"
                                                  d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7a7 7 0 0 1-7 7Z" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategoryId.HasValue || !string.IsNullOrEmpty(Model.SelectedBrand) || Model.SelectedBrandId.HasValue || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                    {
                        <div class="active-filters-widget p-3 mb-4 rounded-3" style="background-color: #eaf5ee; border: 1px solid #c3e5d1;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-dark" style="font-size: 0.95rem;">Aktiv Filtrlər:</span>
                                <a asp-controller="Shop" asp-action="Index" asp-route-sort="@Model.Sort" class="text-danger small text-decoration-none fw-semibold">Sıfırla ✕</a>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategoryId.HasValue)
                                {
                                    var catName = Model.Categories.FirstOrDefault(c => c.Slug == Model.SelectedCategory || c.Id == Model.SelectedCategoryId)?.Name 
                                        ?? (Model.SelectedCategory?.ToLower() switch { "food" => "Yem", "cloth" => "Geyim", "food-dog" => "İt Yemi", "food-cat" => "Pişik Yemi", "food-bird" => "Quş Yemi", "cloth-dog" => "İt Geyimi", "pisik-geyimi" => "Pişik Geyimi", "dogs" => "İt", "cats" => "Pişik", "birds" => "Quş", _ => Model.SelectedCategory });
                                    <a asp-controller="Shop" asp-action="Index" 
                                       asp-route-brand="@Model.SelectedBrand" 
                                       asp-route-brandId="@Model.SelectedBrandId"
                                       asp-route-minPrice="@Model.MinPrice" 
                                       asp-route-maxPrice="@Model.MaxPrice" 
                                       asp-route-sort="@Model.Sort" 
                                       class="badge bg-dark text-white text-decoration-none py-2 px-3 rounded-pill d-inline-flex align-items-center gap-1"
                                       title="Kateqoriya filtrini sil">
                                        <span>Kateqoriya: @catName</span>
                                        <iconify-icon icon="ic:round-close" class="ms-1 fs-6"></iconify-icon>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.SelectedBrand) || Model.SelectedBrandId.HasValue)
                                {
                                    var brandName = Model.SelectedBrand ?? Model.Brands.FirstOrDefault(b => b.Id == Model.SelectedBrandId)?.Name;
                                    <a asp-controller="Shop" asp-action="Index" 
                                       asp-route-category="@Model.SelectedCategory" 
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-minPrice="@Model.MinPrice" 
                                       asp-route-maxPrice="@Model.MaxPrice" 
                                       asp-route-sort="@Model.Sort" 
                                       class="badge bg-dark text-white text-decoration-none py-2 px-3 rounded-pill d-inline-flex align-items-center gap-1"
                                       title="Brend filtrini sil">
                                        <span>Brend: @brandName</span>
                                        <iconify-icon icon="ic:round-close" class="ms-1 fs-6"></iconify-icon>
                                    </a>
                                }
                                @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                                {
                                    string priceLabel;
                                    if (!Model.MinPrice.HasValue && Model.MaxPrice.HasValue)
                                    {
                                        priceLabel = $"< {Model.MaxPrice} ₼";
                                    }
                                    else if (Model.MinPrice.HasValue && !Model.MaxPrice.HasValue)
                                    {
                                        priceLabel = $">= {Model.MinPrice} ₼";
                                    }
                                    else
                                    {
                                        priceLabel = $"{Model.MinPrice} - {Model.MaxPrice} ₼";
                                    }
                                    <a asp-controller="Shop" asp-action="Index" 
                                       asp-route-category="@Model.SelectedCategory" 
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-brand="@Model.SelectedBrand" 
                                       asp-route-brandId="@Model.SelectedBrandId"
                                       asp-route-sort="@Model.Sort" 
                                       class="badge bg-dark text-white text-decoration-none py-2 px-3 rounded-pill d-inline-flex align-items-center gap-1"
                                       title="Qiymət filtrini sil">
                                        <span>Qiymət: @priceLabel</span>
                                        <iconify-icon icon="ic:round-close" class="ms-1 fs-6"></iconify-icon>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <!-- Categories Widget -->
                    <div class="widget-product-categories pt-3">
                        <h4 class="widget-title">Categories</h4>
                        <ul class="product-categories sidebar-list list-unstyled mb-0">
                            @{
                                var isAllCatActive = string.IsNullOrEmpty(Model.SelectedCategory) && !Model.SelectedCategoryId.HasValue;
                            }
                            <li class="cat-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category=""
                                   asp-route-categoryId=""
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(isAllCatActive ? "active-filter" : "")">All</a>
                            </li>
                            @foreach (var parentCat in Model.Categories.Where(c => c.ParentCategoryId == null))
                            {
                                var isParentActive = (!string.IsNullOrEmpty(Model.SelectedCategory) && 
                                    (Model.SelectedCategory.Equals(parentCat.Slug, StringComparison.OrdinalIgnoreCase) || 
                                     Model.SelectedCategory.Equals(parentCat.Name, StringComparison.OrdinalIgnoreCase))) ||
                                    (Model.SelectedCategoryId.HasValue && Model.SelectedCategoryId.Value == parentCat.Id);

                                <li class="cat-item mb-1">
                                    <a asp-controller="Shop" asp-action="Index"
                                       asp-route-category="@parentCat.Slug"
                                       asp-route-brand="@Model.SelectedBrand"
                                       asp-route-brandId="@Model.SelectedBrandId"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-sort="@Model.Sort"
                                       class="nav-link sidebar-filter-link @(isParentActive ? "active-filter" : "")">@parentCat.Name</a>

                                    @if (parentCat.SubCategories != null && parentCat.SubCategories.Any())
                                    {
                                        <ul class="sub-categories list-unstyled ms-3 mt-1 ps-2 border-start border-2 border-secondary-subtle">
                                            @foreach (var subCat in parentCat.SubCategories)
                                            {
                                                var isSubActive = (!string.IsNullOrEmpty(Model.SelectedCategory) && 
                                                    (Model.SelectedCategory.Equals(subCat.Slug, StringComparison.OrdinalIgnoreCase) || 
                                                     Model.SelectedCategory.Equals(subCat.Name, StringComparison.OrdinalIgnoreCase))) ||
                                                    (Model.SelectedCategoryId.HasValue && Model.SelectedCategoryId.Value == subCat.Id);

                                                <li class="cat-item mb-1">
                                                    <a asp-controller="Shop" asp-action="Index"
                                                       asp-route-category="@subCat.Slug"
                                                       asp-route-brand="@Model.SelectedBrand"
                                                       asp-route-brandId="@Model.SelectedBrandId"
                                                       asp-route-minPrice="@Model.MinPrice"
                                                       asp-route-maxPrice="@Model.MaxPrice"
                                                       asp-route-sort="@Model.Sort"
                                                       class="nav-link sidebar-filter-link @(isSubActive ? "active-filter" : "")">@subCat.Name</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Brands Widget -->
                    <div class="widget-product-brands pt-4">
                        <h4 class="widget-title">Brands</h4>
                        <ul class="product-brands sidebar-list list-unstyled mb-0">
                            @{
                                var isAllBrandsActive = string.IsNullOrEmpty(Model.SelectedBrand) && !Model.SelectedBrandId.HasValue;
                            }
                            <li class="brand-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand=""
                                   asp-route-brandId=""
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(isAllBrandsActive ? "active-filter" : "")">All Brands</a>
                            </li>
                            @foreach (var br in Model.Brands)
                            {
                                var isBrActive = (!string.IsNullOrEmpty(Model.SelectedBrand) && 
                                    Model.SelectedBrand.Equals(br.Name, StringComparison.OrdinalIgnoreCase)) ||
                                    (Model.SelectedBrandId.HasValue && Model.SelectedBrandId.Value == br.Id);

                                <li class="brand-item mb-1">
                                    <a asp-controller="Shop" asp-action="Index"
                                       asp-route-category="@Model.SelectedCategory"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-brand="@br.Name"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-sort="@Model.Sort"
                                       class="nav-link sidebar-filter-link @(isBrActive ? "active-filter" : "")">@br.Name</a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Filter By Price Widget -->
                    <div class="widget-price-filter pt-4">
                        <h4 class="widget-title">Filter By Price</h4>
                        <ul class="price-filter sidebar-list list-unstyled mb-0">
                            @{
                                var isAllPricesActive = !Model.MinPrice.HasValue && !Model.MaxPrice.HasValue;
                                var isUnder10Active = !Model.MinPrice.HasValue && Model.MaxPrice == 10;
                                var is10To20Active = Model.MinPrice == 10 && Model.MaxPrice == 20;
                                var is20To30Active = Model.MinPrice == 20 && Model.MaxPrice == 30;
                                var is30To40Active = Model.MinPrice == 30 && Model.MaxPrice == 40;
                                var is40To50Active = Model.MinPrice == 40 && Model.MaxPrice == 50;
                                var isAbove50Active = Model.MinPrice == 50 && !Model.MaxPrice.HasValue;
                            }
                            <li class="price-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice=""
                                   asp-route-maxPrice=""
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(isAllPricesActive ? "active-filter" : "")">All Prices</a>
                            </li>
                            <li class="price-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice=""
                                   asp-route-maxPrice="10"
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(isUnder10Active ? "active-filter" : "")">Less than 10 ₼</a>
                            </li>
                            <li class="price-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="10"
                                   asp-route-maxPrice="20"
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(is10To20Active ? "active-filter" : "")">10 - 20 ₼</a>
                            </li>
                            <li class="price-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="20"
                                   asp-route-maxPrice="30"
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(is20To30Active ? "active-filter" : "")">20 - 30 ₼</a>
                            </li>
                            <li class="price-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="30"
                                   asp-route-maxPrice="40"
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(is30To40Active ? "active-filter" : "")">30 - 40 ₼</a>
                            </li>
                            <li class="price-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="40"
                                   asp-route-maxPrice="50"
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(is40To50Active ? "active-filter" : "")">40 - 50 ₼</a>
                            </li>
                            <li class="price-item mb-1">
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-minPrice="50"
                                   asp-route-maxPrice=""
                                   asp-route-sort="@Model.Sort"
                                   class="nav-link sidebar-filter-link @(isAbove50Active ? "active-filter" : "")">50 ₼ and more</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>