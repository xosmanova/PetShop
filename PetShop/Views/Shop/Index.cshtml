@model PetShop.Models.ShopViewModel

<section id="banner" class="py-3" style="background: #F9F3EC;">
    <div class="container">
        <div class="hero-content py-5 my-3">
            <h2 class="display-1 mt-3 mb-0">Shop</h2>
            <nav class="breadcrumb">
                <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active" aria-current="page">Shop</span>
            </nav>
        </div>
    </div>
</section>

<div class="shopify-grid">
    <div class="container py-5 my-5">
        <div class="row g-md-5 mb-5">

            <main class="col-md-9">
                <div class="filter-shop d-md-flex justify-content-between align-items-center">
                    <div class="showing-product">
                        @{
                            var from = Model.TotalCount == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                            var to = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
                        }
                        <p class="m-0">Showing @from–@to of @Model.TotalCount results</p>
                    </div>
                    <div class="sort-by">
                        <form method="get" asp-controller="Shop" asp-action="Index" id="sortForm">
                            <input type="hidden" name="category" value="@Model.SelectedCategory" />
                            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                            <input type="hidden" name="tag" value="@Model.SelectedTag" />
                            <input type="hidden" name="brand" value="@Model.SelectedBrand" />
                            <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                            <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                            <select name="sort" class="filter-categories border-0 m-0" onchange="this.form.submit()">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Default sorting</option>
                                <option value="name_asc" selected="@(Model.Sort == "name_asc")">Name (A - Z)</option>
                                <option value="name_desc" selected="@(Model.Sort == "name_desc")">Name (Z - A)</option>
                                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Price (Low-High)</option>
                                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Price (High-Low)</option>
                            </select>
                        </form>
                    </div>
                </div>

                <div class="product-grid row">
                    @if (!Model.Products.Any())
                    {
                        <div class="text-center py-5">
                            <h4>Bu filtrə uyğun məhsul tapılmadı.</h4>
                            <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark mt-3">Bütün məhsulları göstər</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            var mainImage = product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                            ?? product.Images.FirstOrDefault()?.ImageUrl
                            ?? "/images/no-image.png";
                            var displayPrice = product.DiscountPrice ?? product.Price;
                            var isWishlisted = Model.WishlistProductIds.Contains(product.Id);

                            <div class="col-md-4 my-4">
                                <div class="card position-relative">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                        <img src="@mainImage" class="img-fluid rounded-4" alt="@product.Name">
                                    </a>
                                    <div class="card-body p-0">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                            <h3 class="card-title pt-4 m-0">@product.Name</h3>
                                        </a>

                                        <div class="card-text">
                                            <h3 class="secondary-font text-primary">@displayPrice ₼</h3>

                                            <div class="d-flex flex-wrap mt-3">
                                                <form asp-controller="Basket" asp-action="AddToCart" method="post" class="me-3">
                                                    <input type="hidden" name="productId" value="@product.Id" />
                                                    <button type="submit" class="btn-cart px-4 pt-3 pb-3 border-0 bg-transparent">
                                                        <h5 class="text-uppercase m-0">Add to Cart</h5>
                                                    </button>
                                                </form>
                                                <a href="#" class="btn-wishlist px-4 pt-3 @(isWishlisted ? "active-wishlist" : "")" data-product-id="@product.Id" title="İstək siyahısına əlavə et">
                                                    <iconify-icon icon="fluent:heart-28-filled" class="fs-5" style="@(isWishlisted ? "color: #dc3545;" : "")"></iconify-icon>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <!-- / product-grid -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="navigation paging-navigation text-center mt-5" role="navigation">
                        <div class="pagination loop-pagination d-flex justify-content-center align-items-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-tag="@Model.SelectedTag"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sort="@Model.Sort"
                                   class="pagination-arrow d-flex align-items-center mx-3">
                                    <iconify-icon icon="ic:baseline-keyboard-arrow-left" class="pagination-arrow fs-1"></iconify-icon>
                                </a>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <span aria-current="page" class="page-numbers mt-2 fs-3 mx-3 current">@i</span>
                                }
                                else
                                {
                                    <a class="page-numbers mt-2 fs-3 mx-3"
                                       asp-controller="Shop" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-category="@Model.SelectedCategory"
                                       asp-route-categoryId="@Model.SelectedCategoryId"
                                       asp-route-tag="@Model.SelectedTag"
                                       asp-route-brand="@Model.SelectedBrand"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-sort="@Model.Sort">@i</a>
                                }
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-controller="Shop" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-category="@Model.SelectedCategory"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-tag="@Model.SelectedTag"
                                   asp-route-brand="@Model.SelectedBrand"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-sort="@Model.Sort"
                                   class="pagination-arrow d-flex align-items-center mx-3">
                                    <iconify-icon icon="ic:baseline-keyboard-arrow-right" class="pagination-arrow fs-1"></iconify-icon>
                                </a>
                            }
                        </div>
                    </nav>
                }

            </main>

            <aside class="col-md-3 mt-5">
                <div class="sidebar">
                    <div class="widget-menu">
                        <div class="widget-search-bar">
                            <div class="search-bar border rounded-2 border-dark-subtle pe-3">
                                <form id="search-form" class="text-center d-flex align-items-center" asp-controller="Shop" asp-action="Search" method="get">
                                    <input type="text" name="query" class="form-control border-0 bg-transparent" placeholder="Search for products" />
                                    <button type="submit" class="border-0 bg-transparent p-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                            <path fill="currentColor"
                                                  d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7a7 7 0 0 1-7 7Z" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Categories Widget -->
                    <div class="widget-product-categories pt-5">
                        <h4 class="widget-title">Categories</h4>
                        <ul class="product-categories sidebar-list list-unstyled">
                            <li class="cat-item">
                                <a asp-controller="Shop" asp-action="Index"
                                   class="nav-link @(string.IsNullOrEmpty(Model.SelectedCategory) && !Model.SelectedCategoryId.HasValue ? "fw-bold text-primary" : "")">All</a>
                            </li>
                            <li class="cat-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="Dogs"
                                   class="nav-link @(Model.SelectedCategory == "Dogs" ? "fw-bold text-primary" : "")">Dogs</a>
                            </li>
                            <li class="cat-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="Food"
                                   class="nav-link @(Model.SelectedCategory == "Food" ? "fw-bold text-primary" : "")">Food</a>
                            </li>
                            <li class="cat-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="Cats"
                                   class="nav-link @(Model.SelectedCategory == "Cats" ? "fw-bold text-primary" : "")">Cats</a>
                            </li>
                            <li class="cat-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="Birds"
                                   class="nav-link @(Model.SelectedCategory == "Birds" ? "fw-bold text-primary" : "")">Birds</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Tags Widget -->
                    <div class="widget-product-tags pt-4">
                        <h4 class="widget-title">Tags</h4>
                        <ul class="product-tags sidebar-list list-unstyled">
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-tag="Pets"
                                   class="nav-link @(Model.SelectedTag == "Pets" ? "fw-bold text-primary" : "")">Pets</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-tag="Clothes"
                                   class="nav-link @(Model.SelectedTag == "Clothes" ? "fw-bold text-primary" : "")">Clothes</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-tag="Foods"
                                   class="nav-link @(Model.SelectedTag == "Foods" ? "fw-bold text-primary" : "")">Foods</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-tag="Toys"
                                   class="nav-link @(Model.SelectedTag == "Toys" ? "fw-bold text-primary" : "")">Toys</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Brands Widget -->
                    <div class="widget-product-brands pt-4">
                        <h4 class="widget-title">Brands</h4>
                        <ul class="product-tags sidebar-list list-unstyled">
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-brand="Denim"
                                   class="nav-link @(Model.SelectedBrand == "Denim" ? "fw-bold text-primary" : "")">Denim</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-brand="Puma"
                                   class="nav-link @(Model.SelectedBrand == "Puma" ? "fw-bold text-primary" : "")">Puma</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-brand="Klaws"
                                   class="nav-link @(Model.SelectedBrand == "Klaws" ? "fw-bold text-primary" : "")">Klaws</a>
                            </li>
                            @foreach (var br in Model.Brands.Where(b => b.Name != "Denim" && b.Name != "Puma" && b.Name != "Klaws"))
                            {
                                <li class="tags-item">
                                    <a asp-controller="Shop" asp-action="Index" asp-route-brand="@br.Name"
                                       class="nav-link @(Model.SelectedBrand == br.Name ? "fw-bold text-primary" : "")">@br.Name</a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Filter By Price Widget -->
                    <div class="widget-price-filter pt-4">
                        <h4 class="widget-title">Filter By Price</h4>
                        <ul class="product-tags sidebar-list list-unstyled">
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-tag="@Model.SelectedTag" asp-route-brand="@Model.SelectedBrand" asp-route-maxPrice="10" class="nav-link @(Model.MaxPrice == 10 && !Model.MinPrice.HasValue ? "fw-bold text-primary" : "")">Less than 10 ₼</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-tag="@Model.SelectedTag" asp-route-brand="@Model.SelectedBrand" asp-route-minPrice="10" asp-route-maxPrice="20" class="nav-link @(Model.MinPrice == 10 && Model.MaxPrice == 20 ? "fw-bold text-primary" : "")">10 - 20 ₼</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-tag="@Model.SelectedTag" asp-route-brand="@Model.SelectedBrand" asp-route-minPrice="20" asp-route-maxPrice="30" class="nav-link @(Model.MinPrice == 20 && Model.MaxPrice == 30 ? "fw-bold text-primary" : "")">20 - 30 ₼</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-tag="@Model.SelectedTag" asp-route-brand="@Model.SelectedBrand" asp-route-minPrice="30" asp-route-maxPrice="40" class="nav-link @(Model.MinPrice == 30 && Model.MaxPrice == 40 ? "fw-bold text-primary" : "")">30 - 40 ₼</a>
                            </li>
                            <li class="tags-item">
                                <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.SelectedCategory" asp-route-tag="@Model.SelectedTag" asp-route-brand="@Model.SelectedBrand" asp-route-minPrice="40" asp-route-maxPrice="50" class="nav-link @(Model.MinPrice == 40 && Model.MaxPrice == 50 ? "fw-bold text-primary" : "")">40 - 50 ₼</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>