@model PetShop.Models.OffersViewModel
@{
    ViewData["Title"] = "Xüsusi Təkliflər və Endirimlər";
}

<section id="banner" class="py-3" style="background: #F9F3EC;">
    <div class="container">
        <div class="hero-content py-5 my-3">
            <h2 class="display-1 mt-3 mb-0">Offers & Deals</h2>
            <nav class="breadcrumb">
                <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active" aria-current="page">Offers</span>
            </nav>
        </div>
    </div>
</section>

<div class="shopify-grid">
    <div class="container py-5 my-3">
        <div class="filter-shop d-md-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div class="showing-product">
                <p class="m-0 fs-5">
                    <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill me-2">
                        <iconify-icon icon="mdi:tag-percent" class="me-1 align-middle"></iconify-icon> SPECIAL OFFERS
                    </span>
                    Cəmi <strong>@Model.TotalCount</strong> endirimli məhsul tapıldı
                </p>
            </div>
            <div class="sort-by mt-3 mt-md-0">
                <form method="get" asp-controller="Offers" asp-action="Index" id="sortForm">
                    <select name="sort" class="filter-categories border-0 m-0" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Default sorting</option>
                        <option value="discount_desc" selected="@(Model.Sort == "discount_desc")">Ən böyük endirimlər</option>
                        <option value="price_asc" selected="@(Model.Sort == "price_asc")">Qiymət (Aşağıdan Yuxarıya)</option>
                        <option value="price_desc" selected="@(Model.Sort == "price_desc")">Qiymət (Yuxarıdan Aşağıya)</option>
                        <option value="name_asc" selected="@(Model.Sort == "name_asc")">Ad (A - Z)</option>
                    </select>
                </form>
            </div>
        </div>

        <div class="product-grid row">
            @if (!Model.Products.Any())
            {
                <div class="col-12 text-center py-5 my-5">
                    <iconify-icon icon="solar:tag-price-bold-duotone" class="text-muted" style="font-size: 80px;"></iconify-icon>
                    <h3 class="mt-3 text-secondary">Hazırda aktiv xüsusi təklif yoxdur</h3>
                    <p class="text-muted">Bütün məhsullarımıza baxmaq üçün mağaza səhifəsinə keçid edin.</p>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-dark mt-2 px-4 py-2 rounded-pill">
                        Mağazaya keçid et
                    </a>
                </div>
            }
            else
            {
                @foreach (var product in Model.Products)
                {
                    var mainImage = product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                        ?? product.Images.FirstOrDefault()?.ImageUrl
                        ?? "/images/no-image.png";
                    var originalPrice = product.Price;
                    var discountPrice = product.DiscountPrice!.Value;
                    var discountPercent = Math.Round((1 - (discountPrice / originalPrice)) * 100);
                    var savingsAmount = originalPrice - discountPrice;
                    var isWishlisted = Model.WishlistProductIds.Contains(product.Id);

                    <div class="col-sm-6 col-md-4 col-lg-3 my-4 d-flex align-items-stretch">
                        <div class="card position-relative h-100 w-100 product-card border-0 shadow-sm rounded-4 p-3 d-flex flex-column justify-content-between">
                            
                            <!-- Discount Badge -->
                            <div class="position-absolute top-0 start-0 m-3 z-1">
                                <span class="badge bg-danger text-white fs-6 px-3 py-2 shadow-sm rounded-pill fw-bold">
                                    -@discountPercent%
                                </span>
                            </div>

                            <div class="d-flex flex-column flex-grow-1">
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="product-image-container" style="height: 260px; width: 100%; overflow: hidden; display: block; border-radius: 1rem; background-color: #f8f9fa;">
                                    <img src="@mainImage" class="img-fluid rounded-4 product-img" alt="@product.Name" loading="lazy" style="height: 100%; width: 100%; object-fit: cover; object-position: center; display: block;">
                                </a>

                                <div class="card-body p-0 pt-3 d-flex flex-column justify-content-between flex-grow-1">
                                    <div>
                                        @if (product.ProductCategory != null)
                                        {
                                            <span class="badge bg-light text-muted small px-2 py-1 mb-1">@product.ProductCategory.Name</span>
                                        }
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none">
                                            <h4 class="card-title m-0 text-dark fw-bold product-title">@product.Name</h4>
                                        </a>
                                    </div>

                                    <div class="card-text mt-auto pt-2">
                                        <div class="d-flex align-items-baseline gap-2">
                                            <span class="secondary-font text-danger fw-bold fs-4">@discountPrice.ToString("0.00") ₼</span>
                                            <del class="text-muted fs-6">@originalPrice.ToString("0.00") ₼</del>
                                        </div>
                                        <div class="small text-success fw-semibold mt-1">
                                            <iconify-icon icon="mdi:check-circle-outline" class="align-middle"></iconify-icon> Qənaət: @savingsAmount.ToString("0.00") ₼
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap mt-3 pt-2 border-top">
                                <form asp-controller="Basket" asp-action="AddToCart" method="post" class="me-2 flex-grow-1">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn-cart w-100 px-3 pt-3 pb-3 border-0 bg-transparent text-center">
                                        <h5 class="text-uppercase m-0" style="font-size: 0.9rem;">Add to Cart</h5>
                                    </button>
                                </form>
                                <a href="#" class="btn-wishlist px-3 pt-3 @(isWishlisted ? "active-wishlist" : "")" data-product-id="@product.Id" title="İstək siyahısına əlavə et">
                                    <iconify-icon icon="fluent:heart-28-filled" class="fs-5" style="@(isWishlisted ? "color: #dc3545;" : "")"></iconify-icon>
                                </a>
                            </div>

                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
