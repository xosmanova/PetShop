@{
    ViewData["Title"] = "About Us";
}

<section id="banner" class="py-3" style="background: #F9F3EC;">
    <div class="container">
        <div class="hero-content py-5 my-3">
            <h2 class="display-1 mt-3 mb-0">About <span class="text-primary">Us</span></h2>
            <nav class="breadcrumb">
                <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active" aria-current="page">About Us</span>
            </nav>
        </div>
    </div>
</section>

<div class="my-5 py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-6 my-4 pe-5">
                <h2>Waggy Necə Yarandı</h2>
                <p>
                    Waggy 2023-cü ildə heyvansevərlərin ehtiyaclarını qarşılamaq məqsədilə yaradıldı.
                    Məqsədimiz — sizin dostlarınız üçün keyfiyyətli qida, geyim və aksesuarları
                    əlçatan qiymətlərlə, sürətli çatdırılma ilə təqdim etməkdir. Bu gün minlərlə
                    məmnun müştəri və onların dörd pəncəli dostları bizimlə birlikdədir.
                </p>
                <a asp-controller="Blog" asp-action="Index"
                   class="btn btn-outline-dark btn-lg text-uppercase fs-6 rounded-1 py-2 px-4">
                    Read Blog
                    <svg width="24" height="24" viewBox="0 0 24 24" class="mb-1">
                        <use xlink:href="#arrow-right"></use>
                    </svg>
                </a>
            </div>
            <div class="col-md-6 my-4">
                <h2>Bizim Haqqımızda Daha Çox</h2>
                <p>Waggy-ni digərlərindən fərqləndirən əsas dəyərlərimiz:</p>
                <p class="m-0">
                    <span class="text-primary">✓</span> 100% orijinal və keyfiyyətli məhsullar
                </p>
                <p class="m-0">
                    <span class="text-primary">✓</span> Sürətli və etibarlı çatdırılma xidməti
                </p>
                <p class="m-0">
                    <span class="text-primary">✓</span> Peşəkar müştəri dəstəyi
                </p>
                <p class="m-0">
                    <span class="text-primary">✓</span> Sərfəli qiymətlər və mütəmadi endirimlər
                </p>
            </div>
        </div>
    </div>
</div>

<div class="my-5 pb-5">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h2 class="display-4">Ən Yaxşı Pet Məhsullarını Waggy-dən Ala Bilərsiniz.</h2>
            </div>
            <div class="col-md-6">
                <p>
                    Heyvanınızın sağlamlığı və rahatlığı bizim üçün önəmlidir. Ona görə də
                    kataloqumuzda yalnız etibarlı brendlərin məhsullarını yerləşdiririk —
                    qida, geyim, oyuncaq və baxım vasitələri daxil olmaqla. Hər bir məhsul
                    diqqətlə seçilir ki, siz və dostunuz üçün ən yaxşı təcrübəni yaşadaq.
                </p>
                <p>
                    İstər gündəlik qida ehtiyacları, istərsə də xüsusi günlər üçün hədiyyələr —
                    Waggy komandası olaraq sizə və pet-inizə ən yaxşı seçimləri təqdim etmək
                    üçün buradayıq. Sualınız olarsa, Contact səhifəmizdən bizimlə əlaqə saxlaya
                    bilərsiniz.
                </p>
            </div>
        </div>
    </div>
</div>