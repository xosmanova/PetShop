@{
    ViewData["Title"] = "Çatdırılma Şərtləri və Məlumatı";
}

<section id="banner" class="py-3" style="background: #F9F3EC;">
    <div class="container">
        <div class="hero-content py-5 my-3">
            <h2 class="display-1 mt-3 mb-0">Delivery <span class="text-primary">Information</span></h2>
            <nav class="breadcrumb">
                <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active" aria-current="page">Delivery Information</span>
            </nav>
        </div>
    </div>
</section>

<div class="my-5 py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="text-center mb-5">
                    <span class="badge bg-secondary-subtle text-primary fs-6 px-3 py-2 rounded-pill fw-semibold mb-2">SÜRƏTLİ VƏ ETİBARLI</span>
                    <h2 class="display-5 fw-bold">Qapınıza Qədər Çatdırılma Xidməti</h2>
                    <p class="text-muted fs-6">Sifarişlərinizin vaxtında və təhlükəsiz çatdırılması üçün peşəkar kuryer xidmətləri ilə çalışırıq.</p>
                </div>

                <!-- 3 Əsas Çatdırılma Şərti Kartı -->
                <div class="row g-4 mb-5">
                    <!-- Müddət -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center" style="background: #fafafa;">
                            <div class="mb-3">
                                <iconify-icon icon="solar:clock-circle-bold-duotone" class="text-primary" style="font-size: 48px;"></iconify-icon>
                            </div>
                            <h4 class="fw-bold mb-2">1 - 3 İş Günü</h4>
                            <p class="text-muted small lh-base">
                                Bakı şəhəri daxilində sifarişlər adətən <strong>24 saat</strong> ərzində, digər regionlara isə <strong>1-3 iş günü</strong> ərzində çatdırılır.
                            </p>
                        </div>
                    </div>

                    <!-- Pulsuz Çatdırılma -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center" style="background: #fafafa;">
                            <div class="mb-3">
                                <iconify-icon icon="solar:gift-bold-duotone" class="text-success" style="font-size: 48px;"></iconify-icon>
                            </div>
                            <h4 class="fw-bold mb-2">50 AZN-dən Pulsuz</h4>
                            <p class="text-muted small lh-base">
                                Səbətinizin ümumi dəyəri <strong>50 AZN və ya daha çox</strong> olduqda, Bakı üzrə çatdırılma tamamilə <strong>PULSUZDUR</strong>.
                            </p>
                        </div>
                    </div>

                    <!-- Bölgələr -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center" style="background: #fafafa;">
                            <div class="mb-3">
                                <iconify-icon icon="solar:map-point-bold-duotone" class="text-primary" style="font-size: 48px;"></iconify-icon>
                            </div>
                            <h4 class="fw-bold mb-2">Bütün Azərbaycan</h4>
                            <p class="text-muted small lh-base">
                                Bakı, Abşeron, Sumqayıt və Azərbaycanın bütün şəhər və rayonlarına sürətli və etibarlı daşınma zəmanəti.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Tariflər və Bölgələr Cədvəli -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-white">
                    <h3 class="fw-bold mb-4">Çatdırılma Zonaları və Qiymət Tarifləri</h3>
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="py-3">Çatdırılma Zonası</th>
                                    <th scope="col" class="py-3">Müddət</th>
                                    <th scope="col" class="py-3">50 AZN-dən Yuxarı</th>
                                    <th scope="col" class="py-3">50 AZN-dən Aşağı</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="py-3">
                                        <strong>Bakı Şəhəri</strong><br />
                                        <small class="text-muted">Mərkəz və ətraf rayonlar</small>
                                    </td>
                                    <td>1 iş günü (24 saat)</td>
                                    <td><span class="badge bg-success py-2 px-3">PULSUZ</span></td>
                                    <td>3.00 ₼</td>
                                </tr>
                                <tr>
                                    <td class="py-3">
                                        <strong>Abşeron & Sumqayıt</strong><br />
                                        <small class="text-muted">Xırdalan, Masazır, Saray, Sumqayıt</small>
                                    </td>
                                    <td>1 - 2 iş günü</td>
                                    <td><span class="badge bg-success py-2 px-3">PULSUZ</span></td>
                                    <td>4.00 ₼</td>
                                </tr>
                                <tr>
                                    <td class="py-3">
                                        <strong>Azərbaycanın Regionları</strong><br />
                                        <small class="text-muted">Gəncə, Şəki, Lənkəran, Quba və bütün rayonlar</small>
                                    </td>
                                    <td>2 - 3 iş günü</td>
                                    <td>5.00 ₼</td>
                                    <td>6.00 ₼</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 p-3 bg-light rounded-3">
                        <h6 class="fw-bold mb-1"><iconify-icon icon="mdi:information-outline" class="text-primary me-1 align-middle"></iconify-icon> Kuryerlə Əlaqə:</h6>
                        <p class="text-muted small mb-0">
                            Kuryerimiz sifarişi çatdırmazdan təxminən 30-60 dəqiqə əvvəl sizinlə qeyd etdiyiniz telefon nömrəsi vasitəsilə əlaqə saxlayacaq və dəqiq vaxtı dəqiqləşdirəcəkdir.
                        </p>
                    </div>
                </div>

                <!-- Alış-verişə davam etmə düyməsi -->
                <div class="text-center">
                    <p class="text-muted mb-3">Ev heyvanınız üçün ən yaxşı məhsulları kəşf edin</p>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary px-5 py-3 rounded-pill fw-semibold text-uppercase">
                        İndi Alış-verişə Başla
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
