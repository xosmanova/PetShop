@model PetShop.DataContext.Entites.Basket

<section id="banner" class="py-3" style="background: #E8F5EE;">
    <div class="container">
        <div class="hero-content py-5 my-3">
            <h2 class="display-1 mt-3 mb-0">Basket</h2>
            <nav class="breadcrumb">
                <a class="breadcrumb-item nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <span class="breadcrumb-item active" aria-current="page">Basket</span>
            </nav>
        </div>
    </div>
</section>

<section id="cart" class="my-5 py-5">
    <div class="container">
        @if (!Model.BasketItems.Any())
        {
            <div class="text-center py-5">
                <h4>Səbətiniz boşdur.</h4>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-dark mt-3">Shop Now</a>
            </div>
        }
        else
        {
            <div class="row g-md-5">
                <div class="col-md-8 pe-md-5">
                    <table class="table">
                        <thead>
                            <tr>
                                <th class="card-title text-uppercase">Product</th>
                                <th class="card-title text-uppercase">Quantity</th>
                                <th class="card-title text-uppercase">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BasketItems)
                            {
                                var mainImage = item.Product.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/no-image.png";
                                var variantLabel = item.ProductVariant != null
                                ? string.Join(" / ", new[] { item.ProductVariant.Size, item.ProductVariant.Weight, item.ProductVariant.Color }.Where(x => !string.IsNullOrEmpty(x)))
                                : null;

                                <tr>
                                    <td class="py-4">
                                        <div class="cart-info d-flex flex-wrap align-items-center">
                                            <div class="col-lg-3">
                                                <img src="@mainImage" alt="@item.Product.Name" class="img-fluid" loading="lazy">
                                            </div>
                                            <div class="col-lg-9">
                                                <div class="card-detail ps-3">
                                                    <h5 class="card-title">@item.Product.Name</h5>
                                                    @if (!string.IsNullOrEmpty(variantLabel))
                                                    {
                                                        <small class="text-secondary fw-medium">@variantLabel</small>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 align-middle">
                                        <form asp-controller="Basket" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                            <input type="hidden" name="basketItemId" value="@item.Id" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1"
                                                   class="form-control input-number text-center p-2 mx-1" style="width:70px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-dark ms-2">Yenilə</button>
                                        </form>
                                    </td>
                                    <td class="py-4 align-middle">
                                        @{
                                            var isDiscounted = item.Product.DiscountPrice.HasValue && item.Product.DiscountPrice.Value < item.Product.Price;
                                            var originalUnitPrice = item.Product.Price + (item.ProductVariant?.PriceModifier ?? 0m);
                                            var originalLineTotal = originalUnitPrice * item.Quantity;
                                            var lineTotal = item.UnitPrice * item.Quantity;
                                        }
                                        <div>
                                            @if (isDiscounted)
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <del class="text-muted text-decoration-line-through small">@originalLineTotal.ToString("0.00") ₼</del>
                                                    <span class="secondary-font fw-bold text-danger fs-5">@lineTotal.ToString("0.00") ₼</span>
                                                </div>
                                                <small class="text-muted d-block" style="font-size: 0.8rem;">
                                                    (@item.UnitPrice.ToString("0.00") ₼ / ədəd)
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="secondary-font fw-bold text-dark fs-5">@lineTotal.ToString("0.00") ₼</span>
                                                <small class="text-muted d-block" style="font-size: 0.8rem;">
                                                    (@item.UnitPrice.ToString("0.00") ₼ / ədəd)
                                                </small>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-4 align-middle">
                                        <form asp-controller="Basket" asp-action="Remove" method="post">
                                            <input type="hidden" name="basketItemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm border-0 bg-transparent">
                                                <svg width="24" height="24" fill="#dc3545">
                                                    <use xlink:href="#trash"></use>
                                                </svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="col-md-4">
                    <!-- Kupon Bölməsi -->
                    <div class="card border-0 shadow-sm rounded-3 p-4 mb-4 bg-light">
                        <h5 class="fw-bold mb-3">
                            <iconify-icon icon="mdi:ticket-percent-outline" class="me-1 align-middle text-primary"></iconify-icon> Kupon Kodu
                        </h5>

                        @if (TempData["CouponSuccess"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3" role="alert">
                                @TempData["CouponSuccess"]
                                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (TempData["CouponError"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3" role="alert">
                                @TempData["CouponError"]
                                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (ViewBag.AppliedCoupon != null)
                        {
                            var coupon = (PetShop.DataContext.Entites.Coupon)ViewBag.AppliedCoupon;
                            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-2 border border-success mb-2">
                                <div>
                                    <span class="badge bg-success px-2 py-1 fs-6">@coupon.Code</span>
                                    <small class="text-muted d-block mt-1">
                                        @(coupon.DiscountType == PetShop.DataContext.Entites.DiscountType.Percentage ? $"{coupon.DiscountValue}% endirim" : $"{coupon.DiscountValue} ₼ endirim")
                                    </small>
                                </div>
                                <form asp-controller="Basket" asp-action="RemoveCoupon" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Kuponu sil">
                                        <iconify-icon icon="mdi:close" class="align-middle"></iconify-icon> Sil
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Basket" asp-action="ApplyCoupon" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="text" name="couponCode" class="form-control text-uppercase" placeholder="Kupon kodunuz" required />
                                <button type="submit" class="btn btn-dark text-nowrap px-3">Tətbiq et</button>
                            </form>
                            <small class="text-secondary fw-medium mt-2 d-block" style="font-size: 12px;">Sınaq üçün: <code class="text-dark fw-bold">PET10</code> və ya <code class="text-dark fw-bold">SAVE20</code></small>
                        }
                    </div>

                    <!-- Səbət Xülasəsi -->
                    <div class="cart-totals card border-0 shadow-sm rounded-3 p-4">
                        <h3 class="pb-3 fw-bold border-bottom">Səbət Xülasəsi</h3>
                        <table class="table mb-4">
                            <tbody>
                                <tr class="py-2">
                                    <th class="border-0 text-dark fw-semibold">Ara Cəm</th>
                                    <td class="border-0 text-end fw-semibold">
                                        @(((decimal)(ViewBag.Subtotal ?? Model.BasketItems.Sum(i => i.UnitPrice * i.Quantity))).ToString("0.00")) ₼
                                    </td>
                                </tr>
                                @if (ViewBag.DiscountAmount != null && (decimal)ViewBag.DiscountAmount > 0)
                                {
                                    var couponCode = ViewBag.AppliedCoupon != null ? ((PetShop.DataContext.Entites.Coupon)ViewBag.AppliedCoupon).Code : "";
                                    <tr class="py-2 text-danger">
                                        <th class="border-0">
                                            Kupon Endirimi @(!string.IsNullOrEmpty(couponCode) ? $"({couponCode})" : "")
                                        </th>
                                        <td class="border-0 text-end fw-bold">
                                            -@(((decimal)ViewBag.DiscountAmount).ToString("0.00")) ₼
                                        </td>
                                    </tr>
                                }
                                <tr class="order-total border-top border-bottom py-3">
                                    <th class="fs-5 fw-bold text-dark">Yekun Məbləğ</th>
                                    <td class="text-end">
                                        <span class="price-amount text-primary fs-4 fw-bold">
                                            @(((decimal)(ViewBag.Total ?? Model.BasketItems.Sum(i => i.UnitPrice * i.Quantity))).ToString("0.00")) ₼
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="button-wrap row g-2">
                            <div class="col-md-12">
                                <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary p-3 text-uppercase rounded-2 w-100 fw-bold">
                                    Sifarişi Rəsmiləşdir <iconify-icon icon="mdi:arrow-right" class="ms-1 align-middle"></iconify-icon>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
